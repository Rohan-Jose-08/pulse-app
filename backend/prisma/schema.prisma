// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  binaryTargets   = ["native", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // This 'id' will store the Firebase UID
  id        String    @id @unique @map("firebase_uid") // Use @map to give it a clearer database column name if preferred
  email     String    @unique
  displayName String?
  firebaseUid String   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Profile enhancement fields
  bio         String?
  profileImageUrl String?
  // Human readable location label provided by user (e.g. "London, UK") – kept for quick display; canonical structured location below
  locationLabel    String?
  // Reference to structured Location row (latitude/longitude + address components)
  locationId       Int?
  location         Location? @relation(fields: [locationId], references: [id])
  locationUpdatedAt  DateTime?
  website     String?
  socialLinks Json? // Store social media links as JSON object
  interests   String[] // Array of user interests
  isVerified  Boolean @default(false)
  followersCount Int @default(0)
  followingCount Int @default(0)
  
  // Additional profile fields for enhanced features
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  occupation  String?
  company     String?
  education   String?
  languages   String[] // Array of languages user speaks
  timezone    String?
  preferences Json? // Store user preferences as JSON object
  
  // Settings fields
  // Privacy settings
  profileVisibility    String? @default("public") // public, friends, private
  locationSharing      String? @default("friends") // everyone, friends, nobody
  pulseHistoryVisibility String? @default("friends") // public, friends, only_me
  friendRequestsFrom   String? @default("everyone") // everyone, friends_of_friends, nobody
  showOnlineStatus     Boolean @default(true)
  allowMessageRequests Boolean @default(true)
  showInSearch         Boolean @default(true)
  
  // Notification settings
  pushNotificationsEnabled Boolean @default(true)
  notifyNewPulsesNearby    Boolean @default(true)
  notifyPulseInvitations   Boolean @default(true)
  notifyPulseUpdates       Boolean @default(true)
  notifyNewMessages        Boolean @default(true)
  notifyNewFollowers       Boolean @default(true)
  notifyFriendRequests     Boolean @default(true)
  notifyPostReactions      Boolean @default(true)
  
  // Appearance settings
  themePreference      String? @default("system") // system, light, dark
  languagePreference   String? @default("en_US")
  textSizeScale        Float?  @default(1.0)
  
  // Other settings
  hapticFeedbackEnabled Boolean @default(true)
  activityStatusVisible Boolean @default(true)
  
  // Blocked users
  blockedUsers    BlockedUser[] @relation("BlockingUser")
  blockedByUsers  BlockedUser[] @relation("BlockedUser")
  
  // Social features
  followers   Follow[] @relation("UserFollowers")
  following   Follow[] @relation("UserFollowing")
  
  // Content
  createdPulses Pulse[] @relation("CreatedPulses")
  participatingPulses Pulse[] @relation("PulseParticipants")
  
  // Posts (for future implementation)
  posts       Post[]   @relation("UserPosts")
  
  // Notifications
  notifications Notification[] @relation("UserNotifications")

  // Messaging
  conversations Conversation[] @relation("ConversationParticipants")
  directConversations DirectConversation[] @relation("DirectConversationParticipants")
  pulseConversations  PulseConversation[]  @relation("PulseConversationParticipants")
  createdGroupConversations GroupConversation[] @relation("GroupConversationCreator")
  groupConversations GroupConversation[] @relation("GroupConversationParticipants")
  sentMessages  Message[]
  messageReactions MessageReaction[]

  // Invitations (group chat / pulse invites)
  sentInvitations     ConversationInvitation[] @relation("ConversationInviter")
  receivedInvitations ConversationInvitation[] @relation("ConversationInvitee")

  // Highlights (collections of past pulses)
  highlights          Highlight[] @relation("UserHighlights")

  @@index([locationId])
}

model Pulse {
  id           String    @id @default(cuid())
  title        String
  description  String
  // Structured location reference (nullable for legacy pulses without location)
  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id])
  eventTime    DateTime
  // Active window for the pulse (when it should be considered live/visible as active)
  activeFrom   DateTime  @default(now())
  activeUntil  DateTime? // Optional; if null, client may treat eventTime or other heuristics
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isPublic     Boolean   @default(true)
  tags         String[]
  imageUrl     String?   // URL of the pulse image

  // Creator of the pulse
  authorId     String
  author       User      @relation("CreatedPulses", fields: [authorId], references: [id])

  // Participants (legacy relation - kept for backward compatibility)
  participants User[]    @relation("PulseParticipants")
  
  // Enhanced member management with roles
  members      PulseMember[]
  
  // Additional pulse features
  maxParticipants Int?
  currentParticipants Int @default(0)
  category    String?
  difficulty  String? // Easy, Medium, Hard
  price       Decimal? @db.Decimal(10, 2)
  currency    String? @default("USD")
  isRecurring Boolean @default(false)
  recurrencePattern Json? // Store recurrence pattern as JSON
  
  // Pulse settings
  allowGuestInvites  Boolean @default(true)  // Whether non-admins can invite others
  requireApproval    Boolean @default(false) // Whether joins require admin approval
  isArchived         Boolean @default(false) // Soft delete / archive

  // Back relation to conversations (group chat)
  conversations Conversation[]
  // New back relation to PulseConversation
  pulseConversations PulseConversation[]

  // Highlights - video moments captured during this pulse
  highlights Highlight[]

  @@index([activeFrom])
  @@index([activeUntil])
  @@index([activeFrom, activeUntil])
  @@index([locationId])
  @@index([isArchived])
}

// Pulse membership with roles for enhanced pulse management
// Roles: OWNER (creator), ADMIN (co-organizer), MODERATOR (can manage chat), MEMBER (regular participant)
model PulseMember {
  id        String   @id @default(cuid())
  pulseId   String
  pulse     Pulse    @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  joinedAt  DateTime @default(now())
  invitedBy String?  // User ID who invited this member
  
  // Permissions (can be customized per member, null means use role defaults)
  canInvite     Boolean? // Override: can invite new members
  canRemove     Boolean? // Override: can remove other members
  canEdit       Boolean? // Override: can edit pulse details
  canManageChat Boolean? // Override: can manage chat (pin, delete messages)
  
  // Status
  isMuted       Boolean @default(false) // Muted from chat
  isBanned      Boolean @default(false) // Banned from pulse
  bannedAt      DateTime?
  bannedReason  String?
  
  @@unique([pulseId, userId])
  @@index([pulseId])
  @@index([userId])
  @@index([role])
}

// Structured location shared by Users and Pulses
model Location {
  id         Int      @id @default(autoincrement())
  name       String   // Short label or place name (e.g. "Central Park")
  street     String
  city       String
  state      String
  postalCode String
  country    String
  latitude   Float
  longitude  Float
  // Exact venue / external provider enrichment
  // Google Places (or other) place identifier when sourced from an autocomplete/details flow
  placeId           String?   // Partial unique index applied via migration (WHERE placeId IS NOT NULL)
  // Full formatted address returned by provider (if any)
  formattedAddress  String?
  // Provider place types (Google) or internal classification tags
  types             String[]  @default([])
  // Raw provider address components / payload for future parsing (NOT PII beyond address)
  raw               Json?
  // Source of this location record (e.g. GOOGLE_PLACES, REVERSE_GEOCODE, MANUAL)
  locationSource    String?
  // Optional horizontal accuracy in meters if client provided an exact device reading
  accuracyMeters    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Back relations
  users   User[]
  pulses  Pulse[]

  @@index([latitude, longitude])
  @@index([city])
  @@index([country])
  @@index([placeId])
}

// Follow relationship for social features
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Post model for future social features
model Post {
  id          String   @id @default(cuid())
  content     String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(true)
  
  authorId    String
  author      User     @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Post interactions
  likes       Like[]   @relation("PostLikes")
  comments    Comment[] @relation("PostComments")
  
  @@index([authorId])
  @@index([createdAt])
}

// Like model for post interactions
model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// Comment model for post interactions
model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([userId])
}

// Notification model for user notifications
model Notification {
  id          String   @id @default(cuid())
  type        String   // Follow, Like, Comment, Pulse, etc.
  title       String
  message     String
  isRead      Boolean  @default(false)
  data        Json?    // Additional notification data
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// Real-time messaging models
model Conversation {
  id              String   @id @default(cuid())
  participants    User[]   @relation("ConversationParticipants")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageText String?
  lastSenderId    String?
  messages        Message[]

  // Link to a Pulse when this is a pulse group chat (temporary room)
  pulseId   String?
  pulse     Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  // Group chat metadata
  isGroup   Boolean  @default(false)
  name      String?
  avatarUrl String?

  invitations ConversationInvitation[]

  @@unique([pulseId])
}

// New: Split conversation structures for clarity and simpler querying.
// Direct (1:1 or small non-pulse) conversations
model DirectConversation {
  id              String   @id @default(cuid())
  participants    User[]   @relation("DirectConversationParticipants")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageText String?
  lastSenderId    String?
  name            String?
  avatarUrl       String?

  @@index([updatedAt])
}

// Pulse group chat conversations
model PulseConversation {
  id              String   @id @default(cuid())
  pulseId         String   @unique
  pulse           Pulse    @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  participants    User[]   @relation("PulseConversationParticipants")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageText String?
  lastSenderId    String?
  name            String?
  avatarUrl       String?

  @@index([updatedAt])
}

// Normal group chat conversations (not tied to pulses)
model GroupConversation {
  id              String   @id @default(cuid())
  name            String
  description     String?
  avatarUrl       String?
  creatorId       String
  creator         User     @relation("GroupConversationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants    User[]   @relation("GroupConversationParticipants")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageText String?
  lastSenderId    String?

  @@index([updatedAt])
  @@index([creatorId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String?
  imageUrl       String?
  videoUrl       String?
  createdAt      DateTime @default(now())
  deliveredTo    String[] @default([]) // Array of user IDs who have received the message
  readBy         String[] @default([]) // Array of user IDs who have read the message
  repliedToId    String?  // ID of the message being replied to

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]
  repliedTo      Message?     @relation("MessageReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")

  @@index([conversationId])
  @@index([senderId])
  @@index([repliedToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@index([emoji])
}

// Unified invitation model for all conversation types (group chats, pulse chats, direct messages)
model ConversationInvitation {
  id             String        @id @default(cuid())
  conversationId String?       // Optional - not needed for FOLLOW_REQUEST
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inviterId      String
  inviter        User          @relation("ConversationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId      String
  invitee        User          @relation("ConversationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status         String        @default("PENDING") // PENDING, ACCEPTED, DECLINED, REVOKED
  invitationType String        @default("GROUP_CHAT") // GROUP_CHAT, PULSE_CHAT, DIRECT_MESSAGE, FOLLOW_REQUEST
  createdAt      DateTime      @default(now())
  respondedAt    DateTime?

  @@index([inviteeId])
  @@index([conversationId])
  @@index([status])
  @@index([invitationType])
  @@index([inviterId, inviteeId, invitationType]) // Composite index for follow request lookups
}

// Unified invitation system - supports group chats, pulse chats, direct messages, and follow requests
// invitationType helps frontend display appropriate UI and context for each type
// For FOLLOW_REQUEST: conversationId is null, invitation represents a follow request between users

// Blocked users - for privacy and safety
model BlockedUser {
  id            String   @id @default(cuid())
  blockingUserId String
  blockedUserId  String
  reason         String?
  createdAt      DateTime @default(now())

  blockingUser User @relation("BlockingUser", fields: [blockingUserId], references: [id], onDelete: Cascade)
  blockedUser  User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockingUserId, blockedUserId])
  @@index([blockingUserId])
  @@index([blockedUserId])
}

// Highlights - short videos captured during pulses (like Instagram Stories/Highlights)
// Users capture video moments during pulse events that can be saved as highlights
model Highlight {
  id           String   @id @default(cuid())
  videoUrl     String   // URL of the video file
  thumbnailUrl String?  // Thumbnail/preview image
  duration     Int      // Video duration in seconds
  caption      String?  // Optional text caption for the video
  
  // Link to the pulse where this highlight was captured
  pulseId      String
  pulse        Pulse    @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  
  // Owner of the highlight
  userId       String
  user         User     @relation("UserHighlights", fields: [userId], references: [id], onDelete: Cascade)
  
  // Visibility settings
  isPublic     Boolean  @default(true)
  viewCount    Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId])
  @@index([pulseId])
  @@index([createdAt])
}

// ============================================================================
// ML RECOMMENDATION SYSTEM MODELS
// ============================================================================

// Track user interactions with pulses for ML training
model PulseInteraction {
  id              String   @id @default(cuid())
  userId          String
  pulseId         String
  interactionType String   // 'view', 'join', 'message', 'invite', 'share', 'recommendation_view', 'recommendation_click'
  duration        Int?     // Duration in seconds (for view interactions)
  timestamp       DateTime @default(now())
  
  // Additional context
  source          String?  // 'feed', 'map', 'recommendation', 'search', 'notification'
  deviceType      String?  // 'ios', 'android', 'web'
  
  @@index([userId])
  @@index([pulseId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([interactionType])
}

// Store precomputed recommendations for fast retrieval
model PulseRecommendation {
  id           String   @id @default(cuid())
  userId       String
  pulseId      String
  score        Float    // Recommendation score (0.0 - 1.0)
  reason       String?  // Human-readable reason for recommendation
  generatedAt  DateTime @default(now())
  
  // Track if user interacted with this recommendation
  viewed       Boolean  @default(false)
  clicked      Boolean  @default(false)
  
  @@index([userId, score(sort: Desc)])
  @@index([generatedAt])
  @@index([userId, generatedAt])
}

// User embeddings for similarity-based recommendations
model UserEmbedding {
  userId     String   @id
  embedding  Float[]  // Vector embedding representation of user
  updatedAt  DateTime @default(now())
  
  @@index([updatedAt])
}

// Cache user feature vectors for ML
model UserFeatureCache {
  userId                  String   @id
  avgSessionDuration      Float?
  preferredCategories     String[] // Most common categories user interacts with
  preferredTimeSlots      String[] // Time of day user is most active
  socialActivityScore     Float?   // Measure of social engagement
  messagingFrequency      Float?   // Messages per session
  inviteAcceptanceRate    Float?   // Ratio of accepted invites
  lastPulseJoinedAt       DateTime?
  totalPulsesJoined       Int      @default(0)
  totalPulsesCreated      Int      @default(0)
  avgDistanceKm           Float?   // Average distance of pulses user joins
  
  updatedAt               DateTime @default(now())
  
  @@index([updatedAt])
}

// ============================================================================
// MODERATION & SAFETY SYSTEM MODELS
// ============================================================================

// Content reports - users can report pulses, messages, users, or highlights
model ContentReport {
  id             String   @id @default(cuid())
  reporterId     String   // User who submitted the report
  
  // What is being reported (only one should be set)
  reportedUserId    String?  // Reported user
  reportedPulseId   String?  // Reported pulse
  reportedMessageId String?  // Reported message
  reportedHighlightId String? // Reported highlight
  reportedPostId    String?  // Reported post
  
  // Report details
  category       String   // SPAM, HARASSMENT, HATE_SPEECH, VIOLENCE, INAPPROPRIATE, SCAM, IMPERSONATION, OTHER
  subcategory    String?  // More specific violation type
  description    String?  // Optional user description of the issue
  evidence       String[] @default([]) // URLs to screenshots or other evidence
  
  // Moderation status
  status         String   @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  priority       String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  
  // AI moderation fields
  aiAnalyzed        Boolean   @default(false)
  aiConfidenceScore Float?    // 0.0-1.0 confidence in violation
  aiCategories      String[]  @default([]) // AI-detected categories
  aiRecommendation  String?   // AUTO_DISMISS, AUTO_ACTION, NEEDS_REVIEW
  
  // Resolution
  reviewedBy     String?  // Admin user ID who reviewed
  reviewedAt     DateTime?
  resolution     String?  // ACTION_TAKEN, NO_VIOLATION, DUPLICATE, INVALID
  actionTaken    String?  // WARNING, CONTENT_REMOVED, USER_SUSPENDED, USER_BANNED
  resolutionNote String?  // Internal note about resolution
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reportedPulseId])
  @@index([reportedMessageId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([aiRecommendation])
}

// Moderation actions taken on content/users
model ModerationAction {
  id             String   @id @default(cuid())
  
  // Target of the action
  targetUserId   String?  // User being moderated
  targetPulseId  String?  // Pulse being moderated
  targetMessageId String? // Message being moderated
  targetHighlightId String? // Highlight being moderated
  targetPostId   String?  // Post being moderated
  
  // Action details
  actionType     String   // WARNING, CONTENT_HIDDEN, CONTENT_REMOVED, USER_MUTED, USER_SUSPENDED, USER_BANNED, APPEAL_GRANTED
  reason         String   // Reason for the action
  category       String?  // Violation category
  
  // Duration (for temporary actions)
  duration       Int?     // Duration in hours (null = permanent)
  expiresAt      DateTime?
  
  // Tracking
  performedBy    String   // Admin user ID or "SYSTEM" for automated
  isAutomated    Boolean  @default(false)
  relatedReportId String? // Link to the report that triggered this
  
  // Appeal handling
  appealStatus   String?  // NONE, PENDING, GRANTED, DENIED
  appealNote     String?
  appealedAt     DateTime?
  appealReviewedBy String?
  appealReviewedAt DateTime?
  
  // Notification
  notificationSent Boolean @default(false)
  
  createdAt      DateTime @default(now())
  
  @@index([targetUserId])
  @@index([targetPulseId])
  @@index([actionType])
  @@index([performedBy])
  @@index([createdAt])
  @@index([expiresAt])
}

// User muting - users can mute other users (hide their content without blocking)
model MutedUser {
  id            String   @id @default(cuid())
  mutingUserId  String   // User who muted
  mutedUserId   String   // User who is muted
  reason        String?  // Optional reason
  muteMessages  Boolean  @default(true)  // Hide their messages
  mutePulses    Boolean  @default(true)  // Hide their pulses
  mutePosts     Boolean  @default(true)  // Hide their posts
  createdAt     DateTime @default(now())
  
  @@unique([mutingUserId, mutedUserId])
  @@index([mutingUserId])
  @@index([mutedUserId])
}

// Content moderation flags - track moderation state of content
model ContentModerationFlag {
  id          String   @id @default(cuid())
  
  // Content being flagged
  pulseId     String?  @unique
  messageId   String?  @unique
  highlightId String?  @unique
  postId      String?  @unique
  
  // Moderation state
  isHidden    Boolean  @default(false) // Hidden from public view
  isRemoved   Boolean  @default(false) // Soft-deleted
  reason      String?  // Reason for flag
  
  // AI analysis cache
  aiAnalyzedAt     DateTime?
  aiToxicityScore  Float?    // 0.0-1.0
  aiSpamScore      Float?    // 0.0-1.0
  aiViolenceScore  Float?    // 0.0-1.0
  aiAdultScore     Float?    // 0.0-1.0
  aiCategories     String[]  @default([])
  
  hiddenAt    DateTime?
  hiddenBy    String?  // Admin ID or "SYSTEM"
  removedAt   DateTime?
  removedBy   String?  // Admin ID or "SYSTEM"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isHidden])
  @@index([isRemoved])
  @@index([aiToxicityScore])
}

// User moderation status - track user account restrictions
model UserModerationStatus {
  userId         String   @id
  
  // Warning system
  warningCount   Int      @default(0)
  lastWarningAt  DateTime?
  
  // Trust score (for automated moderation decisions)
  trustScore     Float    @default(1.0) // 0.0-1.0, lower = less trusted
  
  // Restrictions
  isMuted        Boolean  @default(false) // Can't send messages
  mutedUntil     DateTime?
  muteReason     String?
  
  isSuspended    Boolean  @default(false) // Can't access account
  suspendedUntil DateTime?
  suspendReason  String?
  
  isBanned       Boolean  @default(false) // Permanent ban
  bannedAt       DateTime?
  banReason      String?
  
  // Content restrictions
  canCreatePulses  Boolean @default(true)
  canSendMessages  Boolean @default(true)
  canPostHighlights Boolean @default(true)
  requiresModeration Boolean @default(false) // All content needs approval
  
  // Appeal info
  lastAppealAt   DateTime?
  appealCooldown DateTime? // Can't appeal until this date
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([isMuted])
  @@index([isSuspended])
  @@index([isBanned])
  @@index([trustScore])
}

// Admin users for moderation dashboard
model AdminUser {
  id           String   @id @default(cuid())
  userId       String   @unique // Reference to regular User
  role         String   @default("MODERATOR") // MODERATOR, SENIOR_MODERATOR, ADMIN, SUPER_ADMIN
  
  // Permissions
  canViewReports      Boolean @default(true)
  canResolveReports   Boolean @default(true)
  canWarnUsers        Boolean @default(true)
  canMuteUsers        Boolean @default(true)
  canSuspendUsers     Boolean @default(false)
  canBanUsers         Boolean @default(false)
  canRemoveContent    Boolean @default(true)
  canViewAnalytics    Boolean @default(false)
  canManageAdmins     Boolean @default(false)
  
  // Activity tracking
  reportsReviewed Int      @default(0)
  actionsPerformed Int     @default(0)
  lastActiveAt    DateTime?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([role])
  @@index([isActive])
}

// Moderation audit log - comprehensive logging of all moderation activity
model ModerationAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String?  // null for system actions
  action       String   // Action type
  targetType   String   // USER, PULSE, MESSAGE, HIGHLIGHT, POST, REPORT
  targetId     String   // ID of the target
  details      Json?    // Additional details as JSON
  ipAddress    String?
  userAgent    String?
  
  createdAt    DateTime @default(now())
  
  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
