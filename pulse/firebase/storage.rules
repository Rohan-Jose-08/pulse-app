rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow public read access for pulse images
    match /pulses/{pulseId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
